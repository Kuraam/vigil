{
  "redirects": [{ "source": "/deck", "destination": "/deck/", "permanent": false }],
  "rewrites": [{ "source": "/((?!deck(?:/|$)).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/registerSW.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/((?!assets/|icons/).*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
